{
    "name": "hyderkamran/laravel-voipnow",
    "description": "A production-ready Laravel package to interact with the VoipNow UnifiedAPI v5 (REST) and SystemAPI (SOAP).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/haider-kamran/laravel-voipnow",
    "keywords": [
        "4psa",
        "laravel-voipnow",
        "voipnow",
        "voipnow-unified-api",
        "voipnow-laravel-package",
        "hyderkamran-voipnow"
    ],
    "autoload": {
        "psr-4": {
            "HyderKamran\\VoipNow\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Kamran Haider",
            "email": "kamrankhosa40@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "HyderKamran\\VoipNow\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HyderKamran\\VoipNow\\VoipNowServiceProvider"
            ],
            "aliases": {
                "VoipNow": "HyderKamran\\VoipNow\\VoipNowFacade",
                "VoipNowSoap": "HyderKamran\\VoipNow\\VoipNowSoapFacade"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
